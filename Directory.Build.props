<!--
  文件职责：为 SideStage 解决方案统一声明目标运行时和编译约束。

  设计约束：
    - 桌面分身库只面向 Windows x64，不把跨平台假设带入会话实现。
    - 默认开启可空引用和隐式 using，降低重复样板代码，同时保持编译器检查。
    - UI 宿主是否使用 WinForms/WPF 由独立宿主项目决定，Core 不因本文件自动引用 UI 框架。
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <!-- 仅桌面程序和它的离线体验包限制 WinForms 的卫星资源。英文随框架内置；
       不改变可嵌入库、代理或第三方宿主的本地化策略。 -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SideStage.App' Or '$(MSBuildProjectName)' == 'SideStage.App.FrameCheck'">
    <SatelliteResourceLanguages>zh-Hans;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- 目录里没有 DLL 不等于运行时和翻译都在；从 SDK 实际将要写入单文件的条目核对。
       只约束安装包和体验包，不限制其他宿主或开发者选择框架依赖发布。 -->
  <Target Name="CheckSideStageDesktopBundle" AfterTargets="PrepareForBundle"
          Condition="'$(PublishSingleFile)' == 'true' And '$(SideStagePublishAgentSeparately)' == 'true' And ('$(MSBuildProjectName)' == 'SideStage.App' Or '$(MSBuildProjectName)' == 'SideStage.App.FrameCheck')">
    <ItemGroup>
      <_RequiredDesktopAssembly Include="System.Private.CoreLib.dll;System.Windows.Forms.dll;zh-Hans\System.Windows.Forms.resources.dll;zh-Hant\System.Windows.Forms.resources.dll" />
      <_RequiredDesktopAssembly Remove="@(FilesToBundle->'%(RelativePath)')" />
    </ItemGroup>
    <Error Condition="'@(_RequiredDesktopAssembly)' != ''" Text="桌面单文件缺少运行时或翻译：@(_RequiredDesktopAssembly)" />
  </Target>
</Project>
