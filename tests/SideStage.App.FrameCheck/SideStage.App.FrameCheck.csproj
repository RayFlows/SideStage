<!-- 交互桌面回归验收程序。读取本进程测试窗口的实际合成像素，手动运行，避免在无桌面的 CI 中抢占焦点。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>../../src/SideStage.App/app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SideStage.App/SideStage.App.csproj" />
  </ItemGroup>
  <!-- 体验 ZIP 以 FrameCheck 为唯一入口；保留程序集引用，不分发被引用主程序的启动壳和配置。 -->
  <Target Name="OmitReferencedAppHost" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'SideStage.exe' Or '%(ResolvedFileToPublish.RelativePath)' == 'SideStage.runtimeconfig.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'SideStage.deps.json'" />
    </ItemGroup>
  </Target>
</Project>
