<!--
  文件职责：定义 SideStage Windows 桌面应用、图标、字体与自包含安装入口。

  界面通过独立的 SideStage.Windows 库调用 Windows RDP ActiveX：
    - 不负责调度、业务流程或游戏适配。
    - 启动时只读检查系统状态，不自动连接或改变系统设置。
    - 断开预览和注销子会话提供为两个不同的显式操作。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SideStage</AssemblyName>
    <RootNamespace>SideStage.App</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>../../assets/branding/SideStage.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>SideStage</Product>
    <AssemblyTitle>SideStage</AssemblyTitle>
  </PropertyGroup>
  <!-- 小型登录入口使用 Windows 自带的 .NET Framework。独立运行不依赖用户安装新版 .NET。 -->
  <Target Name="CompileStartupGate" BeforeTargets="PrepareResources" Inputs="StartupGate/Dispatcher.cs;app.manifest"
          Outputs="$(IntermediateOutputPath)SideStage.StartupGate.exe">
    <Csc Sources="StartupGate/Dispatcher.cs" References="$(SystemRoot)/Microsoft.NET/Framework64/v4.0.30319/mscorlib.dll;$(SystemRoot)/Microsoft.NET/Framework64/v4.0.30319/System.dll;$(SystemRoot)/Microsoft.NET/Framework64/v4.0.30319/System.Core.dll;$(SystemRoot)/Microsoft.NET/Framework64/v4.0.30319/System.Xml.dll"
         NoStandardLib="true" NoConfig="true" DefineConstants="STARTUP_GATE" TargetType="winexe" Platform="x64"
         Deterministic="true" Win32Manifest="app.manifest" OutputAssembly="$(IntermediateOutputPath)SideStage.StartupGate.exe" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)SideStage.StartupGate.exe" LogicalName="SideStage.StartupGate.exe" WithCulture="false" />
    <AssemblyMetadata Include="SideStage.UpdateRepository" Value="$(SideStageUpdateRepository)" />
    <AssemblyMetadata Include="SideStage.CnbRepository" Value="$(SideStageCnbRepository)" />
    <AssemblyMetadata Include="SideStage.UpdatePublicKey" Value="$(SideStageUpdatePublicKey)" />
    <InternalsVisibleTo Include="SideStage.App.Tests" />
    <PackageReference Include="Svg" Version="3.4.8" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <EmbeddedResource Include="Artwork/GiltInnerFrame.svg" LogicalName="SideStage.App.GiltInnerFrame.svg" />
    <EmbeddedResource Include="StartupInventory.ps1" LogicalName="SideStage.StartupInventory.ps1" />
    <Content Include="../../LICENSE" Link="Licenses/SideStage-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- GDI 和 GDI+ 通过安装目录中的真实路径加载字体，不能让单文件打包器把 TTF 当作待解压的二进制。 -->
    <Content Include="Artwork/Fonts/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="SideStage.App.SideStage.ico" />
    <EmbeddedResource Include="Artwork/SettingsGear.png" LogicalName="SideStage.App.SettingsGear.png" />
    <EmbeddedResource Include="Artwork/UpdateSources/*.svg" LogicalName="SideStage.App.UpdateSources.%(Filename)%(Extension)" />
    <Content Include="Artwork/UpdateSources/NOTICE.txt" Link="Licenses/UpdateSources.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="SideStage.App.FrameCheck" />
    <ProjectReference Include="../SideStage.Core/SideStage.Core.csproj" />
    <ProjectReference Include="../SideStage.Windows/SideStage.Windows.csproj" />
  </ItemGroup>
</Project>
